<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Change ONLY this line if you move to a different PC or your SQL Server
      instance name is different. Everything else in the app reads from here.
      If your SQL Server was installed as a NAMED instance (e.g. SQLEXPRESS)
      use: Data Source=localhost\SQLEXPRESS
    -->
    <add name="LoginDB"
         connectionString="Data Source=localhost;Initial Catalog=22-48044-2_LoginDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=30;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
